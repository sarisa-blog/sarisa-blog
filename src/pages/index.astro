---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS, CATEGORIA_SLUGS } from '../lib/categorias';
import HierarquiaEstrutural from '../components/HierarquiaEstrutural.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);

// contagem real por categoria, só pra dar contexto honesto na grade
// (não esconde categoria vazia, mas também não finge que tem post nela)
const countPorCategoria = Object.fromEntries(
  CATEGORIA_SLUGS.map((slug) => [slug, allPosts.filter((p) => p.data.categoria === slug).length])
);

// Banda de números — valores reais confirmados pelo usuário em 19/ago/2026.
// "Anos de atuação" tirado por enquanto (a preencher depois).
const STATS = [
  { label: 'Patrimônio sob consultoria', value: 'R$103M+' },
  { label: 'Estruturas desenhadas', value: '1.078' },
];
---

<BaseLayout
  title="Sarisa"
  description="Estrutura acima de narrativa. Análise técnica de macro, derivativos e engenharia de portfólio para quem já entende o básico."
  transparentHeader
>
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container-wide hero-inner">
      <p class="kicker hero-anim hero-anim-1">Sarisa</p>
      <p class="hero-phrase hero-anim hero-anim-2">Não fazemos call de mercado. Fazemos matemática de risco.</p>
      <h1 class="hero-anim hero-anim-3">Estrutura acima de narrativa.</h1>
      <div class="hero-rule hero-anim hero-anim-4"></div>
      <p class="lede hero-anim hero-anim-5">
        Macro, derivativos e engenharia de portfólio com o rigor de quem precifica,
        não de quem convence. Sem simplificar pra buscar alcance.
      </p>
    </div>
  </section>

  <section class="stats-band">
    <div class="container-wide stats-inner">
      {STATS.map((s) => (
        <div class="stat">
          <p class="stat-value">{s.value}</p>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide hierarquia-teaser-section">
    <p class="kicker">Como pensamos</p>
    <h2>A hierarquia que organiza cada estrutura</h2>
    <p class="hierarquia-teaser-lede">
      Quando variáveis entram em conflito, esta é a ordem de prioridade —
      sempre. Uma narrativa forte nunca supera deterioração estrutural.
    </p>
    <HierarquiaEstrutural />
    <a class="hierarquia-teaser-link" href="/filosofia">Ver a filosofia completa →</a>
  </section>

  <section class="container-wide pilares-section">
    <p class="kicker">O que cobrimos</p>
    <h2>Pilares</h2>
    <div class="pilares-grid">
      {CATEGORIA_SLUGS.map((slug) => {
        const n = countPorCategoria[slug];
        return (
          <a class="pilar-card" href={`/blog/categoria/${slug}/`}>
            <span class="pilar-label">{CATEGORIAS[slug]}</span>
            <span class="pilar-count">{n > 0 ? `${n} post${n === 1 ? '' : 's'}` : 'em breve'}</span>
            <span class="pilar-arrow">→</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container">
    <h2>Últimos posts</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <span class="post-date">
              {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}
            </span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
      {posts.length === 0 && <p class="empty">Nenhum post publicado ainda.</p>}
    </ul>
  </section>

  <section class="about-teaser">
    <div class="container about-inner">
      <div>
        <p class="kicker">Sobre a Sarisa</p>
        <p class="about-text">
          Conteúdo técnico denso não busca alcance fácil. Busca quem já opera e
          quer entender a mecânica real por trás da estrutura, não só o resultado
          prometido.
        </p>
      </div>
      <a class="about-link" href="/sobre">Conhecer a Sarisa →</a>
    </div>
  </section>

  <section class="cta-final">
    <div class="container cta-final-inner">
      <p class="cta-final-title">Quer conversar sobre uma estrutura específica?</p>
      <a class="cta-final-link" href="/contato">Fala com a Sarisa →</a>
    </div>
  </section>

  <style>
    /* ---- Hero: pronto pra receber foto de fundo.
       Quando o arquivo existir, ele aparece atrás do gradiente/overlay
       automaticamente — não precisa mexer em mais nada além de colocar o
       arquivo em public/images/hero-home.jpg (recomendado: 1920x1080+,
       already-dark ou tratável, mesmo padrão B&W/escurecido dos carrosséis). */
    .hero {
      position: relative;
      min-height: 82vh;
      display: flex;
      align-items: flex-end;
      padding: 4rem 0 4.5rem;
      border-bottom: 1px solid var(--border);
      background-image: linear-gradient(180deg, rgba(11,11,11,0.35) 0%, rgba(11,11,11,0.92) 100%), url('/images/hero-home.jpg');
      background-size: cover;
      background-position: center;
      background-color: var(--bg);
    }
    @media (max-width: 640px) {
      .hero { min-height: 60vh; }
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 20% 30%, rgba(191,174,130,0.06), transparent 60%);
      pointer-events: none;
    }
    .hero-inner {
      position: relative;
    }
    /* Fonte unica no bloco inteiro do hero (Cormorant Garamond), variando
       so peso/itálico por elemento — nao mistura mais com a sans do resto
       do site aqui dentro. */
    .hero .kicker {
      font-family: 'Cormorant Garamond', var(--font-serif);
      font-weight: 600;
      font-style: normal;
      letter-spacing: 0.28em;
    }
    .hero-phrase {
      font-family: 'Cormorant Garamond', var(--font-serif);
      font-style: italic;
      font-weight: 500;
      font-size: clamp(1.15rem, 2.4vw, 1.55rem);
      color: #fdfcf9;
      margin: 0.15rem 0 0;
      max-width: 32rem;
    }
    .hero h1 {
      font-family: 'Cormorant Garamond', var(--font-serif);
      font-weight: 700;
      font-style: normal;
      font-size: clamp(2.3rem, 6vw, 3.75rem);
      margin: 0.75rem 0 0;
      letter-spacing: -0.01em;
    }
    .hero-rule {
      width: 4.5rem;
      height: 2px;
      background: var(--gold);
      margin: 1.15rem 0 1.15rem;
      transform-origin: left;
    }
    .lede {
      font-family: 'Cormorant Garamond', var(--font-serif);
      font-weight: 400;
      font-size: 1.3rem;
      color: var(--text-body);
      max-width: 34rem;
    }
    .cta {
      display: inline-block;
      margin-top: 1.5rem;
      color: var(--gold);
      font-weight: 700;
    }

    /* ---- Sequencia de abertura: cada elemento entra na vez, fica visivel
       pra sempre depois (nao some). Efeito chamativo concentrado no h1
       (fade + subida + leve escala) e no traco dourado que "desenha" logo
       depois dele. */
    .hero-anim {
      opacity: 0;
      animation: hero-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .hero-anim-1 { animation-delay: 0.05s; }
    .hero-anim-2 { animation-delay: 0.35s; }
    .hero-anim-3 {
      animation-name: hero-in-title;
      animation-delay: 0.85s;
    }
    .hero-rule.hero-anim-4 {
      animation-name: hero-in-rule;
      animation-delay: 1.55s;
    }
    .hero-anim-5 { animation-delay: 1.75s; }

    @keyframes hero-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes hero-in-title {
      from { opacity: 0; transform: translateY(22px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes hero-in-rule {
      from { opacity: 0; transform: scaleX(0); }
      to { opacity: 1; transform: scaleX(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-anim {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }

    /* ---- Banda de números (esqueleto — valores reais entram depois) ---- */
    .stats-band {
      border-bottom: 1px solid var(--border);
      background: var(--bg-elevated);
    }
    .stats-inner {
      padding: 2.75rem 1.25rem;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .stat-value {
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--gold-dim);
      margin: 0 0 0.35rem;
      font-variant-numeric: tabular-nums;
    }
    .stat-label {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin: 0;
    }
    @media (max-width: 720px) {
      .stats-inner { grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.25rem; }
    }

    /* ---- Teaser da hierarquia estrutural (reaproveita o componente da
       página de Filosofia, só que em destaque logo na home) ---- */
    .hierarquia-teaser-section {
      padding: 3.5rem 1.25rem 1rem;
    }
    .hierarquia-teaser-section h2 {
      margin: 0.35rem 0 0.75rem;
      font-size: 1.5rem;
    }
    .hierarquia-teaser-lede {
      color: var(--text-body);
      max-width: 34rem;
      margin: 0 0 0.5rem;
    }
    .hierarquia-teaser-link {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--gold);
      font-weight: 700;
    }

    /* ---- Grade de pilares (categorias) ---- */
    .pilares-section {
      padding: 3.5rem 1.25rem 1rem;
    }
    .pilares-section h2 {
      margin: 0.35rem 0 1.5rem;
    }
    .pilares-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .pilar-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 1.4rem 1.5rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      background: var(--bg-elevated);
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .pilar-card:hover {
      text-decoration: none;
      border-color: var(--gold-dim);
      background: var(--bg-card);
    }
    .pilar-card:hover .pilar-label {
      color: var(--gold);
    }
    .pilar-label {
      font-weight: 700;
      font-size: 1.02rem;
      transition: color 0.15s ease;
    }
    .pilar-count {
      color: var(--text-muted);
      font-size: 0.78rem;
      white-space: nowrap;
      margin-right: 0.25rem;
    }
    .pilar-arrow {
      color: var(--gold-dim);
      font-size: 1rem;
    }
    @media (max-width: 860px) {
      .pilares-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .pilares-grid { grid-template-columns: 1fr; }
      .pilar-card { flex-wrap: wrap; }
    }

    section.container {
      padding: 3rem 0;
    }
    .post-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
    }
    .post-list li {
      border-bottom: 1px solid var(--border-dim);
    }
    .post-list a {
      display: block;
      padding: 1.25rem 0;
      color: inherit;
    }
    .post-list a:hover {
      text-decoration: none;
    }
    .post-list a:hover .post-title {
      color: var(--gold);
    }
    .post-date {
      display: block;
      color: var(--text-muted);
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
    }
    .post-title {
      display: block;
      color: #fff;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .post-desc {
      display: block;
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-top: 0.25rem;
    }
    .empty {
      color: var(--text-muted);
    }

    .about-teaser {
      border-top: 1px solid var(--border);
      background: var(--bg-elevated);
    }
    .about-inner {
      padding: 3rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .about-text {
      max-width: 32rem;
      font-size: 1.05rem;
      color: var(--text-body);
      margin: 0.5rem 0 0;
    }
    .about-link {
      color: var(--gold);
      font-weight: 700;
      white-space: nowrap;
    }

    .cta-final {
      border-top: 1px solid var(--border);
    }
    .cta-final-inner {
      padding: 3rem 0 4rem;
      text-align: center;
    }
    .cta-final-title {
      font-size: 1.3rem;
      color: #fff;
      font-weight: 700;
      margin: 0 0 1rem;
    }
    .cta-final-link {
      color: var(--gold);
      font-weight: 700;
      font-size: 1.1rem;
    }
  </style>
</BaseLayout>
