---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Metodologia"
  description="Metodologia Sarisa — página em construção."
>
  <div class="container">
    <p class="kicker">Sarisa</p>
    <h1>Metodologia</h1>
    <p class="building">Página em construção.</p>
  </div>

  <style>
    .container {
      padding: 3rem 0 6rem;
      max-width: var(--content-w);
      min-height: 40vh;
    }
    h1 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      margin: 0.5rem 0 1.5rem;
    }
    .building {
      color: var(--text-muted);
      font-size: 1.1rem;
    }
  </style>
</BaseLayout>
