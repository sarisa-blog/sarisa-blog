---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS, CATEGORIA_SLUGS } from '../../lib/categorias';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Todos os posts da Sarisa: macro, derivativos, cases e engenharia de portfólio.">
  <div class="container">
    <p class="kicker">Sarisa</p>
    <h1>Blog</h1>

    <div class="cat-nav">
      <a href="/blog" class="active">Todos</a>
      {CATEGORIA_SLUGS.map((slug) => (
        <a href={`/blog/categoria/${slug}/`}>{CATEGORIAS[slug]}</a>
      ))}
    </div>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <span class="post-meta">
              <span class="badge">{CATEGORIAS[post.data.categoria]}</span>
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </span>
            </span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
      {posts.length === 0 && <p class="empty">Nenhum post publicado ainda.</p>}
    </ul>
  </div>

  <style>
    .container {
      padding: 3rem 0 4rem;
    }
    h1 {
      font-size: 2rem;
      margin: 0.5rem 0 1.5rem;
    }
    .cat-nav {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .cat-nav a {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.4rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 999px;
    }
    .cat-nav a:hover {
      color: var(--gold);
      text-decoration: none;
      border-color: var(--gold-dim);
    }
    .cat-nav a.active {
      color: var(--gold);
      border-color: var(--gold);
      background: var(--bg-elevated);
    }
    .post-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .post-list li {
      border-bottom: 1px solid var(--border-dim);
    }
    .post-list a {
      display: block;
      padding: 1.5rem 0;
      color: inherit;
    }
    .post-list a:hover {
      text-decoration: none;
    }
    .post-list a:hover .post-title {
      color: var(--gold);
    }
    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .post-date {
      color: var(--text-muted);
      font-size: 0.8rem;
    }
    .post-title {
      display: block;
      color: #fff;
      font-size: 1.25rem;
      font-weight: 700;
    }
    .post-desc {
      display: block;
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-top: 0.35rem;
    }
    .empty {
      color: var(--text-muted);
    }
  </style>
</BaseLayout>
