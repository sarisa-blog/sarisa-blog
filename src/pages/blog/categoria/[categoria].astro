---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS, CATEGORIA_SLUGS } from '../../../lib/categorias';
import { SUBTOPICOS } from '../../../lib/subtopicos';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  return CATEGORIA_SLUGS.map((categoria) => ({
    params: { categoria },
    props: {
      posts: allPosts
        .filter((p) => p.data.categoria === categoria)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { categoria } = Astro.params;
const { posts } = Astro.props;
const label = CATEGORIAS[categoria as keyof typeof CATEGORIAS];
const subtopicos = SUBTOPICOS[categoria as keyof typeof CATEGORIAS];

// Se a categoria tem subtópicos definidos, agrupa os posts por subtópico.
// Posts sem subtópico batendo (ou sem subtópico nenhum) caem num grupo
// "outros" no final, pra não sumir conteúdo por falta de tag.
let grupos: { slug: string; label: string; posts: typeof posts }[] = [];
if (subtopicos) {
  grupos = subtopicos.map((s) => ({
    slug: s.slug,
    label: s.label,
    posts: posts.filter((p) => p.data.subtopico === s.slug),
  }));
  const semSubtopico = posts.filter(
    (p) => !subtopicos.some((s) => s.slug === p.data.subtopico)
  );
  if (semSubtopico.length > 0) {
    grupos.push({ slug: '_outros', label: 'Outros', posts: semSubtopico });
  }
}
---

<BaseLayout
  title={`Blog: ${label}`}
  description={`Posts da Sarisa na categoria ${label}.`}
>
  <div class="container">
    <p class="kicker">Sarisa / Blog</p>
    <h1>{label}</h1>

    <div class="cat-nav">
      <a href="/blog">Todos</a>
      {CATEGORIA_SLUGS.map((slug) => (
        <a href={`/blog/categoria/${slug}/`} class={slug === categoria ? 'active' : ''}>
          {CATEGORIAS[slug]}
        </a>
      ))}
    </div>

    {subtopicos ? (
      <div class="subtopico-list">
        {grupos.map((g, i) => (
          <details class="subtopico-box" open={i === 0}>
            <summary>
              <span class="subtopico-num">{g.slug === '_outros' ? '—' : String(i + 1).padStart(2, '0')}</span>
              <span class="subtopico-label">{g.label}</span>
              <span class="subtopico-count">{g.posts.length} post{g.posts.length === 1 ? '' : 's'}</span>
              <span class="subtopico-chevron">＋</span>
            </summary>
            <div class="subtopico-body">
              <ul class="post-list">
                {g.posts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}/`}>
                      <span class="post-date">
                        {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}
                      </span>
                      <span class="post-title">{post.data.title}</span>
                      <span class="post-desc">{post.data.description}</span>
                    </a>
                  </li>
                ))}
                {g.posts.length === 0 && <p class="empty">Nenhum post nesse tópico ainda.</p>}
              </ul>
            </div>
          </details>
        ))}
      </div>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
            </a>
          </li>
        ))}
        {posts.length === 0 && <p class="empty">Nenhum post nessa categoria ainda.</p>}
      </ul>
    )}
  </div>

  <style>
    .container {
      padding: 3rem 0 4rem;
    }
    h1 {
      font-size: 2rem;
      margin: 0.5rem 0 1.5rem;
    }
    .cat-nav {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .cat-nav a {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.4rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 999px;
    }
    .cat-nav a:hover {
      color: var(--gold);
      text-decoration: none;
      border-color: var(--gold-dim);
    }
    .cat-nav a.active {
      color: var(--gold);
      border-color: var(--gold);
      background: var(--bg-elevated);
    }

    /* Acordeão de subtópicos */
    .subtopico-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .subtopico-box {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--bg-elevated);
      overflow: hidden;
    }
    .subtopico-box[open] {
      border-color: var(--gold-dim);
    }
    .subtopico-box summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.1rem 1.25rem;
    }
    .subtopico-box summary::-webkit-details-marker {
      display: none;
    }
    .subtopico-box summary:hover .subtopico-label {
      color: var(--gold);
    }
    .subtopico-num {
      color: var(--gold-dim);
      font-weight: 700;
      font-size: 0.9rem;
      min-width: 1.6rem;
    }
    .subtopico-label {
      flex: 1;
      color: #fff;
      font-weight: 700;
      font-size: 1.05rem;
      transition: color 0.15s ease;
    }
    .subtopico-count {
      color: var(--text-muted);
      font-size: 0.8rem;
    }
    .subtopico-chevron {
      color: var(--gold-dim);
      font-size: 1.1rem;
      transition: transform 0.2s ease;
    }
    .subtopico-box[open] .subtopico-chevron {
      transform: rotate(45deg);
    }
    .subtopico-body {
      padding: 0 1.25rem 0.5rem;
      border-top: 1px solid var(--border);
    }
    .subtopico-body .post-list {
      margin: 0;
    }
    .subtopico-body .empty {
      padding: 1.25rem 0;
    }

    .post-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .post-list li {
      border-bottom: 1px solid var(--border-dim);
    }
    .post-list li:last-child {
      border-bottom: none;
    }
    .post-list a {
      display: block;
      padding: 1.5rem 0;
      color: inherit;
    }
    .post-list a:hover {
      text-decoration: none;
    }
    .post-list a:hover .post-title {
      color: var(--gold);
    }
    .post-date {
      display: block;
      color: var(--text-muted);
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
    }
    .post-title {
      display: block;
      color: #fff;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .post-desc {
      display: block;
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-top: 0.25rem;
    }
    .empty {
      color: var(--text-muted);
    }
  </style>
</BaseLayout>
