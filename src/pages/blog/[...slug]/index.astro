---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIAS } from '../../../lib/categorias';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const relacionados = allPosts
  .filter((p) => p.id !== post.id && p.data.categoria === post.data.categoria)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'Sarisa' },
  publisher: { '@type': 'Organization', name: 'Sarisa' },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.heroImage}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updatedDate?.toISOString(),
    tags: post.data.tags,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="container post">
    <p class="kicker">
      <a class="badge" href={`/blog/categoria/${post.data.categoria}/`}>{CATEGORIAS[post.data.categoria]}</a>
    </p>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
      {post.data.updatedDate && (
        <> · atualizado em {post.data.updatedDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}</>
      )}
    </p>

    {post.data.contemDadosIlustrativos && (
      <p class="ilustrativo-note">
        ⚠ Este post contém números ilustrativos/exemplo usados para explicar a mecânica.
        Não são cotações reais de mercado. Ver nota no corpo do texto.
      </p>
    )}

    <div class="prose">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
      </div>
    )}

    <p class="disclaimer">
      Conteúdo informativo e educacional. Não constitui recomendação de investimento.
      Operações com opções e derivativos envolvem risco, inclusive de perda superior ao
      capital alocado.
    </p>

    <div class="author-block">
      <p class="author-name">Sarisa</p>
      <p class="author-bio">
        Macro, derivativos e engenharia de portfólio com o rigor de quem precifica,
        não de quem convence. <a href="/sobre">Sobre a Sarisa →</a>
      </p>
    </div>
  </article>

  {relacionados.length > 0 && (
    <div class="container related-wrap">
      <h2>Continue lendo</h2>
      <ul class="related-list">
        {relacionados.map((r) => (
          <li>
            <a href={`/blog/${r.id}/`}>
              <span class="related-title">{r.data.title}</span>
              <span class="related-desc">{r.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <style>
    .post {
      padding: 3rem 0 2.5rem;
    }
    h1 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      margin: 0.5rem 0 0.75rem;
    }
    .post-meta {
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-bottom: 2rem;
    }
    .ilustrativo-note {
      background: var(--bg-elevated);
      border-left: 3px solid var(--gold-dim);
      padding: 0.75rem 1rem;
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-bottom: 2rem;
    }
    .prose {
      font-size: 1.05rem;
    }
    .prose :global(h2) {
      margin-top: 2.5rem;
      font-size: 1.5rem;
    }
    .prose :global(h3) {
      margin-top: 2rem;
      font-size: 1.2rem;
    }
    .prose :global(p) {
      margin: 1.1rem 0;
    }
    .prose :global(ul),
    .prose :global(ol) {
      padding-left: 1.4rem;
    }
    .prose :global(li) {
      margin: 0.4rem 0;
    }
    .tags {
      display: flex;
      gap: 0.5rem;
      margin: 2.5rem 0;
      flex-wrap: wrap;
    }
    .disclaimer {
      margin-top: 2rem;
    }
    .author-block {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .author-name {
      color: var(--gold);
      font-weight: 800;
      letter-spacing: 0.08em;
      font-size: 0.85rem;
      margin: 0;
    }
    .author-bio {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0;
    }
    .related-wrap {
      padding: 0 0 4rem;
      border-top: 1px solid var(--border);
      padding-top: 2.5rem;
    }
    .related-wrap h2 {
      font-size: 1.1rem;
      margin: 0 0 1rem;
    }
    .related-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.25rem;
    }
    .related-list a {
      display: block;
      padding: 1rem 0;
      color: inherit;
      border-bottom: 1px solid var(--border-dim);
    }
    .related-list a:hover {
      text-decoration: none;
    }
    .related-list a:hover .related-title {
      color: var(--gold);
    }
    .related-title {
      display: block;
      color: #fff;
      font-weight: 700;
      font-size: 1.05rem;
    }
    .related-desc {
      display: block;
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-top: 0.2rem;
    }
  </style>
</BaseLayout>
