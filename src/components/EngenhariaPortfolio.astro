---
// Substitui a grade plana de pilares por uma esfera central (efeito
// metálico via CSS, sem lib 3D) com linhas radiais até cada pilar,
// inspirado no diagrama 360° da referência — mas interativo: clicar na
// esfera revela o texto "sobre a Sarisa" dentro do próprio bloco.
import { CATEGORIAS, CATEGORIA_SLUGS } from '../lib/categorias';

interface Props {
  countPorCategoria: Record<string, number>;
}
const { countPorCategoria } = Astro.props;

const N = CATEGORIA_SLUGS.length;
const RADIUS = 40; // % do container (centro = 50,50)
const pontos = CATEGORIA_SLUGS.map((slug, i) => {
  const angleDeg = -90 + (360 / N) * i; // comeca no topo, sentido horario
  const rad = (angleDeg * Math.PI) / 180;
  const x = 50 + RADIUS * Math.cos(rad);
  const y = 50 + RADIUS * Math.sin(rad);
  // ancora o texto pro lado certo dependendo de onde cai no circulo
  let align: 'left' | 'right' | 'center' = 'center';
  if (Math.cos(rad) > 0.35) align = 'left';
  else if (Math.cos(rad) < -0.35) align = 'right';
  return { slug, label: CATEGORIAS[slug], n: countPorCategoria[slug], x, y, align };
});

const SOBRE_TEXTO =
  'A Sarisa trabalha com macro, derivativos e engenharia de portfólio pra quem já entende o básico ' +
  'e quer profundidade, não simplificação. Toda estrutura que aparece aqui vem acompanhada do ' +
  'cenário em que ela não funciona, não só do payoff bonito. Conteúdo técnico denso não busca ' +
  'alcance fácil — busca quem já opera, já tem patrimônio pra proteger ou construir, e quer entender ' +
  'a mecânica real por trás da estrutura.';
---

<section class="ep-section">
  <p class="kicker">O que cobrimos</p>
  <h2>Engenharia de Portfólio</h2>

  <div class="ep-wrap">
    <div class="ep-diagram" id="ep-diagram" aria-expanded="false" aria-controls="ep-panel">
      <svg class="ep-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {pontos.map((p) => (
          <line x1="50" y1="50" x2={p.x} y2={p.y} class="ep-line" />
        ))}
      </svg>
      <span class="ep-sphere">
        <canvas class="ep-sphere-canvas" id="ep-sphere-canvas"></canvas>
      </span>
      {pontos.map((p) => (
        <span
          class={`ep-label ep-label-${p.align}`}
          style={`left:${p.x}%; top:${p.y}%;`}
        >
          <span class="ep-label-name">{p.label}</span>
          <span class="ep-label-count">{p.n > 0 ? `${p.n} post${p.n === 1 ? '' : 's'}` : 'em breve'}</span>
        </span>
      ))}
    </div>
  </div>

  <div class="ep-panel" id="ep-panel">
    <p class="ep-panel-kicker">Engenharia de Portfólio</p>
    <p class="ep-panel-text">{SOBRE_TEXTO}</p>
    <a class="ep-panel-link" href="/sobre">Ver a página completa →</a>
  </div>

  <!-- fallback simples pra telas pequenas, onde o diagrama radial nao cabe -->
  <div class="ep-grid-fallback">
    {pontos.map((p) => (
      <a class="ep-fallback-card" href={`/blog/categoria/${p.slug}/`}>
        <span class="ep-fallback-label">{p.label}</span>
        <span class="ep-fallback-count">{p.n > 0 ? `${p.n} post${p.n === 1 ? '' : 's'}` : 'em breve'}</span>
        <span class="ep-fallback-arrow">→</span>
      </a>
    ))}
  </div>
</section>

<script is:inline>
  (function () {
    var btn = document.getElementById('ep-diagram');
    var panel = document.getElementById('ep-panel');
    if (!btn || !panel) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('ep-panel-open', open);
    }

    // abre sozinho, uma vez, na primeira vez que a secao entra na tela
    // ao rolar — sem clique, e nao fecha mais depois de aberto
    if ('IntersectionObserver' in window) {
      var section = btn.closest('.ep-section');
      var opened = false;
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && !opened) {
              opened = true;
              setOpen(true);
              io.disconnect();
            }
          });
        },
        { threshold: 0.45 }
      );
      if (section) io.observe(section);
    } else {
      // navegador sem suporte a IntersectionObserver: mostra direto
      setOpen(true);
    }
  })();
</script>

<script>
  // Esfera 3D de verdade (WebGL/Three.js) — icosaedro solido metalico +
  // camada de wireframe dourado por cima, girando devagar, com luzes
  // reais criando brilho especular que muda com a rotacao (nao e truque
  // de CSS). WIP: testar local antes de decidir se entra no ar (pesa
  // mais a pagina, adiciona a dependencia "three").
  import * as THREE from 'three';

  const canvas = document.getElementById('ep-sphere-canvas');
  if (canvas) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 10);
    camera.position.set(0, 0, 4.8);

    // nucleo: esfera bem lisa (64x48 segmentos — silhueta redonda de
    // verdade, nao poligonal), prateada/perolada com toque de transparencia
    const coreGeo = new THREE.SphereGeometry(1, 96, 64);
    const coreMat = new THREE.MeshPhysicalMaterial({
      color: 0xf1efe6,
      metalness: 0.45,
      roughness: 0.22,
      transmission: 0.35,
      thickness: 0.6,
      transparent: true,
      opacity: 0.92,
      emissive: 0x171512,
      emissiveIntensity: 0.1,
    });
    const core = new THREE.Mesh(coreGeo, coreMat);
    scene.add(core);

    // camada de linhas externa: malha bem mais densa (globo com muitos
    // paralelos/meridianos) pra silhueta ficar redonda e cheia de linha
    const wireGeo = new THREE.SphereGeometry(1.1, 72, 48);
    const wireMat = new THREE.MeshBasicMaterial({
      color: 0xe4e0d2,
      wireframe: true,
      transparent: true,
      opacity: 0.4,
    });
    const wire = new THREE.Mesh(wireGeo, wireMat);
    scene.add(wire);

    // segunda esfera de linhas, menor e por dentro do nucleo — "esfera
    // dentro da esfera", visivel por transparencia do nucleo/vidro
    const wireGeo2 = new THREE.SphereGeometry(0.72, 56, 36);
    const wireMat2 = new THREE.MeshBasicMaterial({
      color: 0xcfd8e0,
      wireframe: true,
      transparent: true,
      opacity: 0.3,
    });
    const wireInner = new THREE.Mesh(wireGeo2, wireMat2);
    scene.add(wireInner);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x2a2a28, 1.3));
    scene.add(new THREE.AmbientLight(0x9a9488, 0.6));

    const keyLight = new THREE.PointLight(0xfff8ec, 4.6, 14);
    keyLight.position.set(2.2, 1.8, 2.6);
    scene.add(keyLight);

    const rimLight = new THREE.PointLight(0xcfe3ff, 2.4, 14);
    rimLight.position.set(-2.4, -1.2, -1.8);
    scene.add(rimLight);

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      renderer.setSize(size, size, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    let raf = null;
    let t = 0;
    function tick() {
      t += reduceMotion ? 0 : 0.0035;
      core.rotation.y = t;
      core.rotation.x = Math.sin(t * 0.6) * 0.15;
      wire.rotation.y = -t * 0.7;
      wire.rotation.x = Math.cos(t * 0.5) * 0.12;
      wireInner.rotation.y = t * 1.15;
      wireInner.rotation.x = Math.sin(t * 0.4) * 0.2;
      keyLight.position.x = Math.cos(t * 0.8) * 2.4;
      keyLight.position.z = Math.sin(t * 0.8) * 2.4 + 1.2;
      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }
    tick();

    // pausa o loop quando a aba nao esta visivel, pra nao gastar GPU a toa
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && raf) {
        cancelAnimationFrame(raf);
        raf = null;
      } else if (!document.hidden && !raf) {
        tick();
      }
    });
  }
</script>

<style>
  .ep-section {
    padding: 4.5rem 1.25rem 1rem;
    max-width: var(--wide-w);
    margin: 0 auto;
    text-align: center;
  }
  .ep-section h2 {
    margin: 0.35rem 0 0.4rem;
  }
  .ep-wrap {
    display: flex;
    justify-content: center;
  }
  .ep-diagram {
    position: relative;
    width: min(480px, 96vw);
    aspect-ratio: 1 / 1;
    background: none;
    border: none;
    padding: 0;
    margin: 1rem 0;
    display: block;
  }
  .ep-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ep-line {
    stroke: var(--gold-dim);
    stroke-width: 0.3;
    opacity: 0.55;
    transition: stroke 0.2s ease, opacity 0.2s ease;
  }
  .ep-diagram[aria-expanded='true'] .ep-line {
    stroke: var(--gold);
    opacity: 0.85;
  }

  .ep-sphere {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 21%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 0 1.8rem rgba(230, 226, 210, 0.3));
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .ep-diagram[aria-expanded='true'] .ep-sphere {
    transform: translate(-50%, -50%) scale(1.06);
    filter: drop-shadow(0 0 2.6rem rgba(230, 226, 210, 0.5));
  }
  .ep-sphere-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ep-label {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    pointer-events: none;
    max-width: 5.4rem;
  }
  .ep-label-name {
    color: var(--gold);
    font-weight: 700;
    font-size: clamp(0.66rem, 2.6vw, 0.92rem);
  }
  .ep-label-count {
    color: var(--text-muted);
    font-size: clamp(0.58rem, 2vw, 0.72rem);
  }
  .ep-label-left { align-items: flex-start; text-align: left; }
  .ep-label-right { align-items: flex-end; text-align: right; }
  .ep-label-center { align-items: center; text-align: center; }

  .ep-panel {
    max-width: 38rem;
    margin: 0.5rem auto 0;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.5s ease, opacity 0.4s ease, margin 0.4s ease;
    text-align: left;
  }
  .ep-panel-open {
    max-height: 22rem;
    opacity: 1;
    margin: 1.5rem auto 0;
  }
  .ep-panel-kicker {
    color: var(--gold);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .ep-panel-text {
    color: var(--text-body);
    font-size: 1.02rem;
    margin: 0 0 0.75rem;
  }
  .ep-panel-link {
    color: var(--gold);
    font-weight: 700;
    font-size: 0.92rem;
  }

  /* fallback em grade — só entra em telas muito estreitas (< 360px),
     onde nem com fonte reduzida os 6 rótulos cabem ao redor do círculo */
  .ep-grid-fallback {
    display: none;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1.5rem;
    text-align: left;
  }
  .ep-fallback-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: #fff;
    background: var(--bg-elevated);
  }
  .ep-fallback-label {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .ep-fallback-count {
    color: var(--text-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .ep-fallback-arrow {
    color: var(--gold-dim);
  }

  /* rede de seguranca só pra telas muito estreitas */
  @media (max-width: 359px) {
    .ep-diagram { display: none; }
    .ep-grid-fallback { display: grid; }
  }

</style>
