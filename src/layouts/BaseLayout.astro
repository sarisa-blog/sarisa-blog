---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  transparentHeader?: boolean;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags: string[];
  };
}

const { title, description, ogImage, article, transparentHeader = false } = Astro.props;
const siteName = 'Sarisa';
const fullTitle = title === siteName ? title : `${title} - ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = ogImage ? new URL(ogImage, Astro.site) : new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="pt_BR" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  </head>
  <body>
    <header class:list={['site-header', { 'site-header-overlay': transparentHeader }]}>
      <div class="container-wide site-header-inner">
        <a href="/" class="brand">
          <img src="/logo-sarisa.png" alt="Sarisa Advisory" class="brand-logo" />
        </a>
        <nav class="site-nav">
          <a href="/blog">Blog</a>
          <a href="/filosofia">Filosofia</a>
          <a href="/sobre">Metodologia</a>
          <a href="/contato">Contato</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-wide">
        <p class="disclaimer">
          Sarisa. Conteúdo informativo e educacional, não constitui recomendação de investimento.
          Operações com opções e derivativos envolvem risco, inclusive de perda superior ao capital
          alocado. Rentabilidade passada não garante resultados futuros.
        </p>
        <p class="footer-copy">© {new Date().getFullYear()} Sarisa.</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        padding: 0.85rem 0;
      }
      /* variante flutuante: usada só em paginas com hero de imagem (home),
         pra a imagem "subir" por baixo do header em vez de ficar cortada
         por uma faixa solida em cima. Nas demais paginas o header continua
         normal, ocupando espaco no fluxo. */
      .site-header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        border-bottom: none;
        background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 100%);
      }
      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        row-gap: 0.6rem;
      }
      .brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }
      .brand-logo {
        height: 48px;
        width: auto;
        display: block;
        flex-shrink: 0;
      }
      .site-nav {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        row-gap: 0.4rem;
      }
      .site-nav a {
        color: var(--text-body);
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .site-nav a:hover {
        color: var(--gold);
        text-decoration: none;
      }
      /* abaixo de ~480px, logo+nav não cabem numa linha só (bug encontrado:
         o img com width:auto colapsava pra 0 dentro do flex row apertado) */
      @media (max-width: 480px) {
        .brand-logo { height: 34px; }
        .site-header-inner { justify-content: center; text-align: center; }
        .site-nav { justify-content: center; gap: 1rem 1.1rem; }
        .site-nav a { font-size: 0.82rem; }
      }
      main {
        min-height: 60vh;
      }
      .site-footer {
        margin-top: 4rem;
        padding: 2rem 0 3rem;
      }
      .footer-copy {
        color: var(--text-muted);
        font-size: 0.8rem;
        margin-top: 0.75rem;
      }
    </style>
  </body>
</html>
